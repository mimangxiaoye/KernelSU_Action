# ============================================================
# KernelSU_Action - Xiaomi Redmi 9A / Blossom
# MT6765 / ARM64 / Linux 4.19
# ============================================================

CONFIG_ENV=config.env

# ------------------------------------------------------------
# Kernel source
# ------------------------------------------------------------

KERNEL_SOURCE=https://github.com/jonjeexe/niigo_kernel_xiaomi_blossom
KERNEL_SOURCE_BRANCH=yoka

# IMPORTANT:
# 必须是 arch/arm64/configs/ 中真实存在的 defconfig
KERNEL_CONFIG=blossom_defconfig

KERNEL_IMAGE_NAME=Image.gz
ARCH=arm64

ADD_LOCALVERSION_TO_FILENAME=false


# ------------------------------------------------------------
# Build commands
# ------------------------------------------------------------

# 不强制 LLVM_IAS=1
# 老 MTK 4.19 内核使用 Clang + GNU assembler 更稳
EXTRA_CMDS:LD=ld.lld KCFLAGS=-Wno-error=strict-prototypes

CUSTOM_CMDS:CLANG_TRIPLE=aarch64-linux-gnu-


# ------------------------------------------------------------
# Clang
# ------------------------------------------------------------

USE_CUSTOM_CLANG=false

CUSTOM_CLANG_SOURCE=
CUSTOM_CLANG_BRANCH=

CLANG_BRANCH=master-kernel-build-2022
CLANG_VERSION=r450784e


# ------------------------------------------------------------
# GCC
# ------------------------------------------------------------

ENABLE_GCC_ARM64=true
ENABLE_GCC_ARM32=true

USE_CUSTOM_GCC_64=false
CUSTOM_GCC_64_SOURCE=
CUSTOM_GCC_64_BRANCH=
CUSTOM_GCC_64_BIN=aarch64-linux-android-

USE_CUSTOM_GCC_32=false
CUSTOM_GCC_32_SOURCE=
CUSTOM_GCC_32_BRANCH=
CUSTOM_GCC_32_BIN=arm-linux-androideabi-


# ------------------------------------------------------------
# KernelSU
# ------------------------------------------------------------

ENABLE_KERNELSU=true

KERNELSU_TAG=v0.9.5

KSU_EXPECTED_SIZE=
KSU_EXPECTED_HASH=


# ------------------------------------------------------------
# Kernel configuration
# ------------------------------------------------------------

# 保留源码自身的 LTO 配置
DISABLE-LTO=false

# 老 MTK 内核大量存在 warning
DISABLE_CC_WERROR=true

# KernelSU 需要 KPROBES
ADD_KPROBES_CONFIG=true

# KernelSU / SUSFS 类功能常用
ADD_OVERLAYFS_CONFIG=true

# 4.19 老内核使用 KernelSU patch
APPLY_KSU_PATCH=true

REMOVE_UNUSED_PACKAGES=true


# ------------------------------------------------------------
# AnyKernel3
# ------------------------------------------------------------

USE_CUSTOM_ANYKERNEL3=false

CUSTOM_ANYKERNEL3_SOURCE=
CUSTOM_ANYKERNEL3_BRANCH=


# ------------------------------------------------------------
# ccache
# ------------------------------------------------------------

ENABLE_CCACHE=true


# ------------------------------------------------------------
# DTBO
# ------------------------------------------------------------

NEED_DTBO=false


# ------------------------------------------------------------
# Boot image
# ------------------------------------------------------------

# 第一次只编译 Kernel + AnyKernel3
# 不自动制作 boot.img
BUILD_BOOT_IMG=false

SOURCE_BOOT_IMAGE=
