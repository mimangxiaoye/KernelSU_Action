CONFIG_ENV=config.env

# =========================
# Kernel source
# =========================

KERNEL_SOURCE=https://github.com/jonjeexe/niigo_kernel_xiaomi_blossom
KERNEL_SOURCE_BRANCH=yoka

# IMPORTANT:
# 必须填写 Niigo 源码 arch/arm64/configs/ 中真实存在的 *_defconfig
# 例如：
# KERNEL_CONFIG=xxx_defconfig
KERNEL_CONFIG=blossom_defconfig

# 你的原始 boot.img 已确认使用 Image.gz
KERNEL_IMAGE_NAME=Image.gz

ARCH=arm64

# =========================
# Filename
# =========================

ADD_LOCALVERSION_TO_FILENAME=false

# =========================
# Compiler
# =========================

# 4.19 内核不要强制 LLVM_IAS=1
EXTRA_CMDS:LD=ld.lld KCFLAGS=-Wno-error=strict-prototypes

USE_CUSTOM_CLANG=false

CUSTOM_CLANG_SOURCE=
CUSTOM_CLANG_BRANCH=

CUSTOM_CMDS:CLANG_TRIPLE=aarch64-linux-gnu-

# AOSP Clang
CLANG_BRANCH=master-kernel-build-2022
CLANG_VERSION=r450784e

# =========================
# GCC
# =========================

ENABLE_GCC_ARM64=true
ENABLE_GCC_ARM32=true

USE_CUSTOM_GCC_64=false
CUSTOM_GCC_64_SOURCE=
CUSTOM_GCC_64_BRANCH=
CUSTOM_GCC_64_BIN=aarch64-linux-android-

USE_CUSTOM_GCC_32=false
CUSTOM_GCC_32_SOURCE=
CUSTOM_GCC_32_BRANCH=
CUSTOM_GCC_32_BIN=arm-linux-androideabi-

# =========================
# KernelSU
# =========================

ENABLE_KERNELSU=true

KERNELSU_TAG=v0.9.5

KSU_EXPECTED_SIZE=
KSU_EXPECTED_HASH=

# =========================
# Kernel configuration
# =========================

# Niigo 4.19 内核已经不是你原厂 4.19.127，
# 第一次先不要强制修改 LTO。
DISABLE-LTO=false

# 老 4.19 内核建议关闭 Werror
DISABLE_CC_WERROR=true

# 自动补 Kprobes
ADD_KPROBES_CONFIG=true

# OverlayFS
ADD_OVERLAYFS_CONFIG=true

# KernelSU patch
# 主要给较老内核使用
APPLY_KSU_PATCH=true

REMOVE_UNUSED_PACKAGES=true

# =========================
# AnyKernel3
# =========================

USE_CUSTOM_ANYKERNEL3=false

CUSTOM_ANYKERNEL3_SOURCE=
CUSTOM_ANYKERNEL3_BRANCH=

# =========================
# Ccache
# =========================

ENABLE_CCACHE=true

# =========================
# DTBO
# =========================

# 先不要生成/修改 DTBO
NEED_DTBO=false

# =========================
# Boot image
# =========================

# 第一次只编译 Kernel + AnyKernel3
# 不直接制作 boot.img
BUILD_BOOT_IMG=false

SOURCE_BOOT_IMAGE=
