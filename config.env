# Lime
CONFIG_ENV=config.env

# 设备内核源码
KERNEL_SOURCE=https://github.com/LimeBlogs/android_kernel_xiaomi_earth
# 内核源码仓库分支
KERNEL_SOURCE_BRANCH=lineage-21
# 内核配置文件，一般是`${设备代号}`_defconfig
## 在设备内核/arch/arm64/configs查看
KERNEL_CONFIG=earth_defconfig
# 输出内核的压缩算法
## 对于我设备而言 可选 Image Image.bz2 Image.gz Image.lz4 Image.lzma Image.lzo
KERNEL_IMAGE_NAME=Image.gz
ARCH=arm64
ADD_LOCALVERSION_TO_FILENAME=false
EXTRA_CMDS:LLVM=1 LLVM_IAS=1

# Clang
## Custom
USE_CUSTOM_CLANG=false
CUSTOM_CLANG_SOURCE=
CUSTOM_CLANG_BRANCH=

### if your set USE CUSTOM CLANG to false than DO NOT CHANGE CUSTOM CMDS
CUSTOM_CMDS:CLANG_TRIPLE=aarch64-linux-gnu-

## AOSP
CLANG_BRANCH=master-kernel-build-2022
CLANG_VERSION=r450784e

# GCC
ENABLE_GCC_ARM64=true
ENABLE_GCC_ARM32=true
USE_CUSTOM_GCC_64=false
CUSTOM_GCC_64_SOURCE=
CUSTOM_GCC_64_BRANCH=
CUSTOM_GCC_64_BIN=aarch64-linux-android-
USE_CUSTOM_GCC_32=false
CUSTOM_GCC_32_SOURCE=
CUSTOM_GCC_32_BRANCH=
CUSTOM_GCC_32_BIN=arm-linux-androideabi-

# KernelSU flags
## 是否启用KernelSU
ENABLE_KERNELSU=true
KERNELSU_TAG=v0.9.5
KSU_EXPECTED_SIZE=
KSU_EXPECTED_HASH=

# Configuration
## 是否关闭`关闭链接时优化`
DISABLE-LTO=true
## 是否禁用`警告视为错误`
DISABLE_CC_WERROR=true
## 自动注入 Kprobes 配置
ADD_KPROBES_CONFIG=true
## 自动注入 OverlayFS 配置
ADD_OVERLAYFS_CONFIG=true
## 是否应用 KernelSU 源码补丁
### 适用于老版本内核4.9<= 推荐打开
APPLY_KSU_PATCH=true
REMOVE_UNUSED_PACKAGES=true

# AnyKernel3
## AnyKernel3 Custom
USE_CUSTOM_ANYKERNEL3=false
CUSTOM_ANYKERNEL3_SOURCE=
CUSTOM_ANYKERNEL3_BRANCH=

# Ccache
ENABLE_CCACHE=true

# DTBO image
NEED_DTBO=false

# Build boot images
## 是否输出Boot镜像
BUILD_BOOT_IMG=false
## 原Room的Boot链接
SOURCE_BOOT_IMAGE=https://raw.githubusercontent.com/LimeBlogs/KernelSU_action/main/boot/boot(2).img

作者: Lime
链接: https://sudachi.top/2026/07/13/sukisu-build/index.html
